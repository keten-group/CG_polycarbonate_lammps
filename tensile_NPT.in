### LAMMPS Input file for Coarse Grained PC tensile test at constant transverse pressure ###
# Author: Heather L. White
# Affiliation: Dept. of Mechanical Engineering, Northwestern University
# Date: April 14, 2025
# Note: This is a very long simulation which may need to be broken into smaller parts

# Required files
# - initial.data (relaxed structure in LAMMPS format)
# - ABA_angle_avg_potential.table (angle potential)
# - BAC_angle_avg_potential.table (angle potential) 
# - ACA_angle_avg_potential.table (angle potential) 

# Required folders
# - deform_data (to catch output trajectory files)
###########################################################

units real                 
atom_style full
boundary p p p 
read_data initial.data
timestep 4.0

# Bond potential
bond_style     morse ### Optimized from harmonic
bond_coeff     1 0 0 0
bond_coeff     2 55.511 0.853 2.897 #AB
bond_coeff     3 55.511 0.853 2.897 #BA
bond_coeff     4 312.924 0.599 3.425 #AC
bond_coeff     5 312.924 0.599 3.425 #CA

#LJ parameter
pair_style lj/cut 15.0
pair_coeff 1 1 0 0 			# Developmental artifact - ignore
pair_coeff 2 2 0 0 			# Developmental artifact - ignore
pair_coeff 3 3 0.345 6.130 	#AA
pair_coeff 4 4 2.087 4.717 	#BB
pair_coeff 5 5 0.345 6.130 	#AA
pair_coeff 6 6 1.822 3.418 	#CC
pair_modify shift yes mix arithmetic
special_bonds lj 0.0 0.0 1.0

# Angle potential
angle_style hybrid harmonic table linear 361
angle_coeff    1 harmonic 409.40 120
angle_coeff    2 table ABA_angle_avg_potential.table Angle 
angle_coeff    3 table BAC_angle_avg_potential.table Angle 
angle_coeff    4 table ACA_angle_avg_potential.table Angle 
angle_coeff    5 table BAC_angle_avg_potential.table Angle 

# Dihedral potential
dihedral_style none

# Thermo output
thermo 1000      
thermo_style custom step temp etotal epair ebond eangle edihed ke pxx pyy pzz lx ly lz vol density       

### Tensile ###

# Bond breaking
fix BondBreakAB all bond/break 1 2 3.7
fix BondBreakBA all bond/break 1 3 3.7
fix BondBreakAC all bond/break 1 4 4.6
fix BondBreakCA all bond/break 1 5 4.6
fix scissionData all ave/time 1 1 10 f_BondBreakAB[2] f_BondBreakBA[2] f_BondBreakAC[2] f_BondBreakCA[2] file bond_break_0.dat

# Keep high-speed atoms from newly broken bonds from crashing simulation
compute myvels all property/atom vx vy vz
compute maxvel all reduce maxabs c_myvels[*]
variable velmag atom "sqrt(c_myvels[1]^2+c_myvels[2]^2+c_myvels[3]^2) > 0.02"
group escapees dynamic all var velmag every 1
thermo_style custom step temp etotal epair ebond eangle edihed ke pxx pyy pzz lx ly lz vol density c_maxvel[*]
fix stopescapees escapees viscous 5000.0

# Calculate stresses and output with trajectories
compute 1 all stress/atom NULL
dump mystressdump all custom 50000 deform_data/Conf_*.dat id type xu yu zu vx vy vz c_1[1] c_1[2] c_1[3] c_1[4] c_1[5] c_1[6]
dump_modify mystressdump sort id

variable mystep equal step
variable boxlen equal "xhi-xlo"
variable engStress equal "-pxx*0.101325"
variable A_t equal "(yhi-ylo) * (zhi-zlo)"
variable A_0 equal ${A_t}
variable cross_section equal "v_A_t"	 

# Thermostat, barostat, and applied deformation 
fix barostat all npt temp 300 300 400 y 1 1 4000 z 1 1 4000
fix stressCurve all print 25 "${mystep} ${boxlen} ${engStress} ${cross_section}" append stressCurve.dat screen no
fix stretch all deform 1 x vel 0.0001 units box

run 5000000

print "All done"
quit
